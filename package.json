{
  "name": "discord-gradio",
  "version": "1.0.2",
  "description": "A stateless engine to bridge any Gradio App (HF Spaces, Shared Links) to Discord Modals with zero-config.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "discord",
    "gradio",
    "huggingface",
    "discord-js",
    "typescript",
    "ai-integration",
    "discord-modals",
    "stateless",
    "esm",
    "cjs"
  ],
  "author": {
    "name": "カット Katt",
    "url": "https://github.com/carlylekatto"
  },
  "license": "MIT",
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.5",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
